# GHCR image (must match your GitHub owner/repo, lowercase)
IMAGE=ghcr.io/instyo/tiny-agent-chat:latest

OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_SESSION_ID=default
CHAT_USER_ID=local
ANVIA_MEMORY_PATH=/app/data/anvia-memory.sqlite

# Optional: prefer Tavily for web_search (otherwise DuckDuckGo)
TAVILY_API_KEY=
